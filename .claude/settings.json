{
  "permissions": {
    "allow": [
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npm run *)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit*)",
      "Bash(fvm flutter analyze*)",
      "Bash(fvm flutter test*)",
      "Bash(fvm dart format *)",
      "Skill(update-config)",
      "Skill(update-config:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-db.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-complexity.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
