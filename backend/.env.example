# ==========================================================================
# geduc-rag — backend · variáveis de ambiente (EXEMPLO)
# Copie para `.env` e preencha com valores reais. NUNCA comite o `.env`.
# Todos os valores abaixo são PLACEHOLDERS.
# ==========================================================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Banco (MySQL / Prisma) ---
# Em dev, aponte SEMPRE para localhost (infra/db/docker-compose.yml sobe um
# MySQL 8.4 na 3307). `allowPublicKeyRetrieval` é necessário no MySQL 8 sem
# TLS (auth caching_sha2_password) — só para dev local.
DATABASE_URL=mysql://rag:rag@localhost:3307/geduc_rag?allowPublicKeyRetrieval=true
# Teto do pool de conexões do driver por instância (default 10).
# DB_POOL_MAX=10

# --- JWT (segredo próprio da plataforma) ---
# Em produção, use >= 32 caracteres.
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_EXPIRATION_TIME=3600s

# --- Bootstrap SUPERADMIN (usado pelo seed; só cria se não existir) ---
# A senha inicial é temporária: o usuário troca no 1º acesso.
BOOTSTRAP_ADMIN_EMAIL=admin@rag.local
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-temporary-password

# --- HTTP hardening ---
# CSV de origens com protocolo. Obrigatória em produção.
# CORS_ORIGINS=http://localhost:8080,https://rag.example.com
# true somente atrás de proxy reverso (Nginx).
TRUST_PROXY=false

# --- Observabilidade ---
# LOG_LEVEL=debug

# --- Rate limit do POST /chat/query (protege custo de LLM) ---
RAG_QUERY_THROTTLE_TTL=60
RAG_QUERY_THROTTLE_LIMIT=10

# --- Embedding provider ---
# `mock` = vetor determinístico por hash do texto (exercita o pipeline, sem
# rede nem download de modelo). `local` roda o modelo via transformers.js
# (baixa o modelo no 1º uso; ver `.docs/ollama-setup.md`).
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
# Prefixos exigidos pelo e5 em cada tipo de texto; ajuste ao trocar de modelo.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Diretório de cache do modelo baixado (opcional; default do transformers.js).
# EMBEDDING_CACHE_DIR=

# --- LLM provider ---
# `mock` = resposta canônica citando o contexto recuperado, sem chamar nada.
# `ollama` chama um servidor Ollama local via HTTP (ver `.docs/ollama-setup.md`).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_WINDOW_TOKENS=8192

# --- Ingestão ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Teto de tamanho do upload de documento, em bytes (10 MiB).
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# --- Consulta ---
RETRIEVAL_TOP_K=5
RERANK_ENABLED=false

# --- Persistência do RAG ---
# `mysql` usa os repositórios Prisma (documentos, chunks, conversas); `memory`
# mantém os adapters in-memory (dev sem banco, testes).
RAG_STORAGE=mysql
